{
  "name": "@proj-airi/database-schema",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Database schema and migrations for AIRI using Drizzle ORM",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./seed-presets-runtime": {
      "types": "./dist/seed-presets-runtime.d.ts",
      "import": "./dist/seed-presets-runtime.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/schema/index.ts src/client.ts src/seed-presets-runtime.ts --format esm --dts --clean",
    "dev": "tsdown src/index.ts src/schema/index.ts src/client.ts src/seed-presets-runtime.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250110.0",
    "drizzle-kit": "^0.31.4",
    "tsdown": "^0.15.4",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^4.0.0"
  }
}
