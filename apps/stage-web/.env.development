# Frontend App URL (for public assets served by static assets worker)
VITE_APP_URL=http://localhost:8787

# API Gateway URL (for API calls and private user assets)
VITE_API_URL=http://localhost:4337

# WebSocket URL for voice streaming
VITE_WS_URL=ws://localhost:4337

# Environment
VITE_ENVIRONMENT=development

# Note: Public default assets (fonts, WASM, default models) are served via
# the static assets worker at ${VITE_APP_URL}/assets/...
# Private user-uploaded assets require auth and are served via
# the API Gateway at ${VITE_API_URL}/api/assets/...
