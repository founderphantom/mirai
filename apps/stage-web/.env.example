# ============================================================================
# DEPRECATED - Service Binding Architecture (2025-10-08+)
# ============================================================================
# The frontend now uses service bindings to communicate with the API Gateway.
# All API requests use relative paths (/api/*) and are proxied internally.
# These environment variables are no longer required.
#
# Previous architecture:
#   Frontend → HTTP over internet → API Gateway
#
# Current architecture:
#   Frontend → Service binding (internal) → API Gateway
#
# Benefits:
#   - Faster (internal Cloudflare network)
#   - Lower latency (~50ms → ~5ms)
#   - No egress costs
#   - More secure
# ============================================================================

# DEPRECATED: No longer used - all API calls use relative paths
# VITE_API_URL=https://api.miraichat.app
# VITE_WS_URL=wss://api.miraichat.app
# VITE_APP_URL=https://app.miraichat.app

# Environment
VITE_ENVIRONMENT=production

# Legacy SDK WebSocket (disabled - not used in current architecture)
VITE_AIRI_WS_URL=

# Note: All assets and API requests now use relative paths:
# - Public assets: /assets/... (served from worker's R2 bucket)
# - API requests: /api/... (proxied to API Gateway via service binding)
# - WebSocket: wss://{current-origin}/api/voice/ws (auto-constructed)
