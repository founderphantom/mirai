# Inworld Runtime API Configuration
# Get your API key from: https://studio.inworld.ai/workspaces
INWORLD_API_KEY=your_inworld_api_key_here

# Server Configuration
WS_APP_PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,https://app.miraichat.app

# VAD Model Configuration (optional)
VAD_MODEL_PATH=./models/silero_vad.onnx

# Graph Visualization (optional, not supported on Windows)
GRAPH_VISUALIZATION_ENABLED=false

# Cloudflare Container Configuration (set via wrangler secret in production)
# These are used locally for development/testing

# Database (for local development)
# DATABASE_URL=http://localhost:8787

# JWT Secret (for authentication)
# JWT_SECRET=your_jwt_secret_here

# Observability (optional)
# SENTRY_DSN=
# NEW_RELIC_LICENSE_KEY=
# DATADOG_API_KEY=

# Feature Flags (optional)
# ENABLE_TELEMETRY=true
# ENABLE_ANALYTICS=true
# ENABLE_DEBUG_LOGGING=false

# Rate Limiting (optional)
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000

# Session Configuration (optional)
# SESSION_TTL_SECONDS=300
# MAX_CONCURRENT_SESSIONS=10

# Audio Configuration (optional)
# MAX_AUDIO_DURATION_SECONDS=300
# AUDIO_SAMPLE_RATE=16000
# AUDIO_CHANNELS=1

# Development Only (DO NOT SET IN PRODUCTION)
# ALLOW_TEST_CLIENT=true
