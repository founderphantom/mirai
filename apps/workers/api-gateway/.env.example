# Environment
ENVIRONMENT=development

# Better Auth
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=your-secret-key-here  # Generate with: npx @better-auth/cli secret

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Polar Payment Platform
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_ORGANIZATION_ID=your-polar-organization-id
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# Inworld AI
INWORLD_API_KEY=your-inworld-api-key
INWORLD_WORKSPACE_ID=your-inworld-workspace-id

# Cloudflare (these are set in wrangler.toml)
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# D1_DATABASE_ID=your-d1-database-id
# KV_NAMESPACE_ID=your-kv-namespace-id
# R2_BUCKET_NAME=mirai-user-assets
